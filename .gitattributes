# Enforce LF line endings cross-platform (prevents mdformat/ruff diffs on Windows).
* text=auto

*.md text eol=lf
*.py text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
.distignore text eol=lf
.editorconfig text eol=lf
.gitattributes text eol=lf
.gitignore text eol=lf
.whitesource text eol=lf
