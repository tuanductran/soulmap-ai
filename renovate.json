{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "github-actions",
    "pep621",
    "pip_requirements",
    "dockerfile"
  ],
  "dependencyDashboardApproval": true,
  "platformAutomerge": false,
  "automerge": false,
  "prConcurrentLimit": 2,
  "prHourlyLimit": 1,
  "commitHourlyLimit": 1,
  "minimumReleaseAge": "3 days",
  "internalChecksFilter": "strict",
  "rebaseWhen": "conflicted",
  "packageRules": [
    {
      "description": "Keep the custom GitHub Action on the Python 3.11 runtime contract",
      "matchDatasources": [
        "docker"
      ],
      "matchManagers": [
        "dockerfile"
      ],
      "matchPackageNames": [
        "python"
      ],
      "versioning": "pep440",
      "allowedVersions": "<3.12"
    },
    {
      "description": "Require explicit approval for CI and release tooling updates",
      "matchManagers": [
        "github-actions",
        "dockerfile"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    },
    {
      "description": "Require explicit approval for major dependency updates",
      "matchUpdateTypes": [
        "major"
      ],
      "dependencyDashboardApproval": true,
      "automerge": false
    }
  ]
}
